<%- include('.././header.ejs') %>

<% 
    // Safely get the first order (for status badges)
    const hasResults = Array.isArray(result) && result.length > 0;
    const firstOrder = hasResults ? (result[0] || {}) : {};
%>

<style>
    #dataTable {
        border-collapse: collapse;
        width: 100%;
    }

    #empoloyees-tblwrapper th,
    #dataTable td {
        border: 1px solid #ddd;
        padding: 8px;
    }

    #empoloyees-tblwrapper th {
        background-color: #f2f2f2;
    }

    #searchInput {
        margin-bottom: 10px;
        padding: 8px;
    }

    #loader-overlay {
        display: none;             /* hidden by default */
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

    #loader {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        border: 6px solid #f3f3f3;
        border-top: 6px solid #3498db;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

<!--**********************************
        Content body start
***********************************-->
<div class="content-body">
    <!-- row -->
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive active-projects style-1">
                            <div class="tbl-caption">
                                <h4 class="heading mb-0">Order Details</h4>
                                <div>
                                    <span>
                                        <% if (hasResults) { %>
                                            <a>
                                                <span class="badge badge-warning dark border-0">
                                                    Current Status :
                                                    <%= (firstOrder.orderstatus || 'N/A').toString().toUpperCase() %>
                                                    <input type="hidden" id="orderid" value="<%= firstOrder.orderid || '' %>">
                                                </span>
                                            </a>

                                            <% if (firstOrder.orderstatus === 'ongoing') { %>
                                                <a>
                                                    <span class="badge badge-dark light border-0 disabled" aria-disabled="true">
                                                        Mark as Ongoing
                                                    </span>
                                                </a>
                                            <% } else { %>
                                                <a onclick="ongoing()">
                                                    <span class="badge badge-dark light border-0">
                                                        Mark as Ongoing
                                                    </span>
                                                </a>
                                            <% } %>

                                            <% if (firstOrder.orderstatus === 'completed') { %>
                                                <a>
                                                    <span class="badge badge-success light border-0 disabled" aria-disabled="true">
                                                        Mark as Completed
                                                    </span>
                                                </a>
                                            <% } else { %>
                                                <a onclick="completed()">
                                                    <span class="badge badge-success light border-0">
                                                        Mark as Completed
                                                    </span>
                                                </a>
                                            <% } %>
                                        <% } else { %>
                                            <span class="badge badge-secondary border-0">
                                                No orders found
                                            </span>
                                        <% } %>

                                        <input
                                            type="text"
                                            class="form-control"
                                            id="searchInput"
                                            style="margin-top: 20px;"
                                            placeholder="Search"
                                        >
                                    </span>
                                </div>
                            </div>

                            <table id="empoloyees-tblwrapper" class="table">
                                <thead>
                                    <tr>
                                        <th>S. No.</th>
                                        <th>Username</th>
                                        <th>Usernumber</th>
                                        <th>User ID</th>
                                        <th>Order ID</th>
                                        <th>Category</th>
                                        <th>Product</th>
                                        <th>Amount</th>
                                        <th>Quantity</th>
                                        <th>Created At</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (hasResults) { %>
                                        <% for (let i = 0; i < result.length; i++) { 
                                            const row = result[i] || {};
                                            const amountNum = Number(row.amount) || 0;
                                        %>
                                            <tr>
                                                <!-- S.No -->
                                                <td><%= i + 1 %></td>

                                                <!-- Username -->
                                                <td>
                                                    <span>
                                                        <%= (row.username || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- Usernumber -->
                                                <td>
                                                    <span>
                                                        <%= (row.usernumber || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- User ID -->
                                                <td>
                                                    <span>
                                                        <%= (row.uniqueid || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- Order ID -->
                                                <td>
                                                    <span>
                                                        <%= (row.orderid || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- Category -->
                                                <td>
                                                    <span>
                                                        <%= (row.category || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- Product (NULL SAFE) -->
                                                <td>
                                                    <span>
                                                        <%= (row.productname || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- Amount (formatted INR) -->
                                                <td>
                                                    <span>
                                                        <%= amountNum.toLocaleString('en-IN', { style: 'currency', currency: 'INR' }) %>
                                                    </span>
                                                </td>

                                                <!-- Quantity -->
                                                <td>
                                                    <span>
                                                        <%= row.quantity || 0 %>
                                                    </span>
                                                </td>

                                                <!-- Created At -->
                                                <td>
                                                    <span>
                                                        <%= row.created_at || '' %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% } %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="10" class="text-center">
                                                No order details available.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>

                            <!-- Loader Overlay -->
                            <div id="loader-overlay">
                                <div id="loader"></div>
                            </div>

                            <!-- Optional status text target -->
                            <div id="demo" style="display:none;"></div>

                        </div> <!-- /.table-responsive -->
                    </div> <!-- /.card-body -->
                </div> <!-- /.card -->
            </div> <!-- /.col-xl-12 -->
        </div> <!-- /.row -->
    </div> <!-- /.container-fluid -->
</div>
<!--**********************************
        Content body end
***********************************-->

<%- include('.././footer.ejs') %>

<script>
    // Search filter
    (function () {
        const searchInput = document.getElementById("searchInput");
        const table = document.getElementById("empoloyees-tblwrapper");

        if (!searchInput || !table) return;

        searchInput.addEventListener("keyup", function () {
            const searchText = this.value.toLowerCase();
            const rows = table.getElementsByTagName("tr");

            // Start iterating from the second row (skipping the table header)
            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                const cells = row.getElementsByTagName("td");
                let found = false;

                for (let j = 0; j < cells.length; j++) {
                    const text = (cells[j].textContent || cells[j].innerText || '').toLowerCase();
                    if (text.includes(searchText)) {
                        found = true;
                        break;
                    }
                }

                row.style.display = found ? "" : "none";
            }
        });
    })();
</script>

<script>
    function completed() {
        const loaderOverlay = document.getElementById("loader-overlay");
        const loader = document.getElementById("loader");
        const demoEl = document.getElementById("demo");

        if (!loaderOverlay || !loader) return;

        loaderOverlay.style.display = "flex"; 

        let orderid = $('#orderid').val();
        let text;

        if (confirm("Are you sure this order has been delivered successfully?")) {
            $.post('/admin/dashboard/users/update/orders', { orderid, status: 'completed' }, data => {
                loaderOverlay.style.display = "none"; // Hide overlay after response

                if (data.msg === 'success') {
                    window.location.reload();
                } else {
                    alert('An Error Occured Please Try Again Later.');
                }
            });
        } else {
            loaderOverlay.style.display = "none";
            text = "You canceled!";
        }

        if (demoEl) {
            demoEl.innerHTML = text || '';
        }
    }

    function ongoing() {
        const loaderOverlay = document.getElementById("loader-overlay");
        const loader = document.getElementById("loader");
        const demoEl = document.getElementById("demo");

        let orderid = $('#orderid').val();
        let text;

        // Prompt for delivery link
        let delivery_link = prompt("Please enter tracking link:", "");
        if (delivery_link == null || delivery_link.trim() === "") {
            text = "User cancelled the prompt.";
            if (demoEl) demoEl.innerHTML = text;
            return;
        }

        // Prompt for delivery partner name
        let delivery_partner = prompt("Please enter delivery partner name:", "");
        if (delivery_partner == null || delivery_partner.trim() === "") {
            text = "User cancelled the prompt.";
            if (demoEl) demoEl.innerHTML = text;
            return;
        }

        // Prompt for AWB number
        let awb_no = prompt("Please enter AWB number:", "");
        if (awb_no == null || awb_no.trim() === "") {
            text = "User cancelled the prompt.";
            if (demoEl) demoEl.innerHTML = text;
            return;
        }

        if (!loaderOverlay || !loader) return;

        loaderOverlay.style.display = "flex"; // Show overlay

        // Send all details to backend
        $.post(
            '/admin/dashboard/users/update/orders',
            {
                orderid,
                delivery_link,
                delivery_partner,
                awp_no: awb_no,   // Pass AWB number as `awp_no`
                status: 'ongoing'
            },
            data => {
                loaderOverlay.style.display = "none"; // Hide overlay after response
                if (data.msg === 'success') {
                    window.location.reload();
                } else {
                    alert('An Error Occured. Please Try Again Later.');
                }
            }
        );

        if (demoEl) {
            demoEl.innerHTML = "Updating order details...";
        }
    }
</script>
