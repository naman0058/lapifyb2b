<%- include('.././header.ejs') %>

<style>
    #empoloyees-tblwrapper {
        border-collapse: collapse;
        width: 100%;
    }

    #empoloyees-tblwrapper th,
    #empoloyees-tblwrapper td {
        border: 1px solid #ddd;
        padding: 8px;
        vertical-align: middle;
    }

    #empoloyees-tblwrapper th {
        background-color: #f2f2f2;
        font-weight: 600;
    }

    #searchInput {
        margin-bottom: 10px;
        padding: 8px;
        max-width: 250px;
    }
</style>

<!--**********************************
        Content body start
***********************************-->
<div class="content-body">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive active-projects style-1">
                            <div class="tbl-caption d-flex justify-content-between align-items-center">
                                <h4 class="heading mb-0">TRANSACTION DETAILS</h4>
                                <div>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="searchInput"
                                        placeholder="Search"
                                    >
                                </div>
                            </div>

                            <table id="empoloyees-tblwrapper" class="table">
                                <thead>
                                    <tr>
                                        <th>S. No.</th>
                                        <th>Username</th>
                                        <th>User Number</th>
                                        <th>User ID</th>
                                        <th>Product Name</th>
                                        <th>Amount</th>
                                        <th>Txn ID</th>
                                        <th>Created At</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (Array.isArray(result) && result.length > 0) { %>
                                        <% for (let i = 0; i < result.length; i++) { 
                                            const row = result[i] || {};
                                            const amountNum = Number(row.amount) || 0;
                                        %>
                                            <tr>
                                                <!-- S.No -->
                                                <td><%= i + 1 %></td>

                                                <!-- Username -->
                                                <td>
                                                    <span>
                                                        <%= (row.username || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- User Number -->
                                                <td>
                                                    <span>
                                                        <%= (row.usernumber || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- User ID -->
                                                <td>
                                                    <span>
                                                        <%= (row.uniqueid || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- Product Name (NULL SAFE) -->
                                                <td>
                                                    <span>
                                                        <%= (row.productname || '').toString().toUpperCase() %>
                                                    </span>
                                                </td>

                                                <!-- Amount -->
                                                <td>
                                                    <span>
                                                        <%= amountNum.toLocaleString('en-IN', { style: 'currency', currency: 'INR' }) %>
                                                    </span>
                                                </td>

                                                <!-- Txn ID -->
                                                <td>
                                                    <span>
                                                        <%= row.txnid || '' %>
                                                    </span>
                                                </td>

                                                <!-- Created At -->
                                                <td>
                                                    <span>
                                                        <%= row.created_at || '' %>
                                                    </span>
                                                </td>

                                                <!-- Description -->
                                                <td>
                                                    <span>
                                                        <%= row.description || 'Payment Added into Wallet' %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% } %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="9" class="text-center">
                                                No transactions found.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>

                        </div> <!-- /.table-responsive -->
                    </div> <!-- /.card-body -->
                </div> <!-- /.card -->
            </div> <!-- /.col-xl-12 -->
        </div> <!-- /.row -->
    </div> <!-- /.container-fluid -->
</div>
<!--**********************************
        Content body end
***********************************-->

<%- include('.././footer.ejs') %>

<script>
    (function () {
        const searchInput = document.getElementById("searchInput");
        const table = document.getElementById("empoloyees-tblwrapper");

        if (!searchInput || !table) return;

        searchInput.addEventListener("keyup", function () {
            const searchText = this.value.toLowerCase().trim();
            const rows = table.getElementsByTagName("tr");

            // Start from 1 to skip table header row
            for (let i = 1; i < rows.length; i++) {
                const row = rows[i];
                const cells = row.getElementsByTagName("td");
                let found = false;

                for (let j = 0; j < cells.length; j++) {
                    const cellText = (cells[j].textContent || cells[j].innerText || '').toLowerCase();
                    if (cellText.includes(searchText)) {
                        found = true;
                        break;
                    }
                }

                row.style.display = found ? "" : "none";
            }
        });
    })();
</script>
