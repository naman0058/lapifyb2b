<%- include('./footer.ejs') %>

<script>
    // Initial values passed from backend
    let lastOrderId = <%- JSON.stringify(lastOrderId || null) %>;
	const todayDate = <%- JSON.stringify(todayDate) %>;           // "YYYY-MM-DD"
const yesterdayDate = <%- JSON.stringify(yesterdayDate) %>;   // "YYYY-MM-DD"

    const newOrderBadge = document.getElementById('newOrderBadge');
	const newOrderAudio  = document.getElementById('newOrderAudio');
    const newOrderToast  = document.getElementById('newOrderToast');
    const newOrderBell   = document.getElementById('newOrderBell');
    const refreshBtn     = document.getElementById('refreshDashboardBtn');
    const recentOrdersTbody = document.getElementById('recentOrdersTableBody');

    function showNewOrderToast(count) {
        if (!newOrderToast) return;
        newOrderToast.style.display = 'block';
        newOrderToast.innerHTML = '<strong>New Order!</strong> ' + count + ' new order(s) received. <a href="#recentOrdersTableBody">View</a>';

        setTimeout(function () {
            newOrderToast.style.display = 'none';
        }, 5000);
    }

    function updateNewOrderBadge(count) {
        if (!newOrderBadge) return;
        if (count > 0) {
            newOrderBadge.style.display = 'inline-block';
            newOrderBadge.textContent = count;
        } else {
            newOrderBadge.style.display = 'none';
        }
    }

    function appendNewOrdersToTable(orders) {
        if (!recentOrdersTbody) return;
        orders.forEach(function(order) {
            const tr = document.createElement('tr');
            tr.setAttribute('data-order-id', order.id);
			tr.setAttribute('data-created-date', order.created_date);
            tr.classList.add('table-success'); // highlight new rows

            tr.innerHTML = `
                <td>NEW</td>
                <td>${order.order_number || order.id}</td>
                <td>${order.customer_name || 'N/A'}</td>
                <td>₹ ${order.total_amount || 0}</td>
                <td>
                    ${order.status === 'pending'
                        ? '<span class="badge badge-warning">Pending</span>'
                        : order.status === 'ongoing'
                            ? '<span class="badge badge-info">Ongoing</span>'
                            : order.status === 'completed'
                                ? '<span class="badge badge-success">Completed</span>'
                                : '<span class="badge badge-secondary">' + order.status + '</span>'}
                </td>
                <td>${order.created_atFormatted}</td>
            `;
            // add at top
            if (recentOrdersTbody.firstChild) {
                recentOrdersTbody.insertBefore(tr, recentOrdersTbody.firstChild);
            } else {
                recentOrdersTbody.appendChild(tr);
            }
        });
    }

  function checkNewOrders() {
    if (!lastOrderId) return;
    fetch(`/admin/api/orders/new?lastOrderId=${lastOrderId}`)
        .then(res => res.json())
        .then(json => {
            const { newCount, latestOrderId, orders } = json;
            if (newCount > 0) {
                lastOrderId = latestOrderId;
                updateNewOrderBadge(newCount);
                appendNewOrdersToTable(orders);
                showNewOrderToast(newCount);
                playNewOrderSound(); // 🔔 ring bell here
				animateBell();
            }
        })
        .catch(err => {
            console.error('Error fetching new orders:', err);
        });
}

    // Poll every 15 seconds for new orders
    setInterval(checkNewOrders, 3600000);

    // Click bell resets badge
    if (newOrderBell) {
        newOrderBell.addEventListener('click', function() {
            updateNewOrderBadge(0);
        });
    }

    if (refreshBtn) {
        refreshBtn.addEventListener('click', function () {
            location.reload();
        });
    }


 const filterButtons = document.querySelectorAll('[data-filter]');

    function applyOrderFilter(filter) {
        if (!recentOrdersTbody) return;
        const rows = recentOrdersTbody.querySelectorAll('tr');

        rows.forEach(row => {
            const createdDate = row.getAttribute('data-created-date'); // "YYYY-MM-DD"
            if (!createdDate) {
                row.style.display = '';
                return;
            }

            if (filter === 'all') {
                row.style.display = '';
            } else if (filter === 'today') {
                row.style.display = (createdDate === todayDate) ? '' : 'none';
            } else if (filter === 'yesterday') {
                row.style.display = (createdDate === yesterdayDate) ? '' : 'none';
            }
        });
    }

    filterButtons.forEach(btn => {
        btn.addEventListener('click', function () {
            filterButtons.forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            const filter = this.getAttribute('data-filter');
            applyOrderFilter(filter);
        });
    });

  function playNewOrderSound() {
        if (!newOrderAudio) return;

        try {
            newOrderAudio.currentTime = 0; // restart from beginning
            const playPromise = newOrderAudio.play();
            if (playPromise !== undefined) {
                playPromise.catch(err => {
                    // Some browsers block auto-play until the user interacts once
                    console.warn('New order sound blocked by browser autoplay policy:', err);
                });
            }
        } catch (e) {
            console.error('Error playing new order sound:', e);
        }
    }

	
	function animateBell() {
    if (!newOrderBell) return;

    newOrderBell.classList.add('shake-bell');

    setTimeout(() => {
        newOrderBell.classList.remove('shake-bell');
    }, 1000);
}

</script>
