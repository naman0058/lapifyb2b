<%- include('./header.ejs') %>


<style>
.shake-bell {
    animation: bell-shake 0.7s ease-in-out;
}

@keyframes bell-shake {
    0% { transform: rotate(0deg); }
    20% { transform: rotate(-15deg); }
    40% { transform: rotate(15deg); }
    60% { transform: rotate(-10deg); }
    80% { transform: rotate(10deg); }
    100% { transform: rotate(0deg); }
}
</style>

<!--**********************************
    Content body start
***********************************-->
<div class="content-body" style="background-color: #f5f5f5;">
    <div class="container-fluid">

        <!-- Top Bar: Title + Notification -->
        <div class="row align-items-center mb-3">
            <div class="col-md-6">
                <h2 class="text-black mb-0">Admin Dashboard</h2>
                <p class="text-muted mb-0">
                    Real-time overview of orders, products, payments, and users.
                </p>
            </div>
            <div class="col-md-6 text-md-right text-left mt-3 mt-md-0">
                <button id="refreshDashboardBtn" class="btn btn-primary btn-sm mr-2">
                    <i class="fa fa-sync"></i> Refresh
                </button>

                <!-- Notification Bell -->
                <button id="newOrderBell"
                        class="btn btn-light position-relative"
                        type="button"
                        title="New Order Notifications">
                    <i class="fa fa-bell"></i>
                    <span id="newOrderBadge"
                          class="badge badge-danger position-absolute"
                          style="top: -5px; right: -5px; display:none;">
                        0
                    </span>
                </button>
            </div>
        </div>

        <!-- =======================
             ORDER OVERVIEW
        ======================== -->
        <h4 class="text-black mb-3">Order Overview</h4>
        <div class="row">

            <!-- Total Orders -->
            <div class="col-xl-3 col-sm-6 mb-3">
                <div class="card same-card shadow-sm border-0" style="border-radius: 12px;">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Total Orders</h6>
                            <h3 class="mb-0">
                                <%= stats.totalOrders %>
                            </h3>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:#e3f2fd;">
                            <i class="fa fa-shopping-cart text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending Orders -->
            <div class="col-xl-3 col-sm-6 mb-3">
                <div class="card same-card shadow-sm border-0" style="border-radius: 12px; background:#fff3cd;">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Pending Orders</h6>
                            <h3 class="mb-0 text-dark">
                                <%= stats.pendingOrder %>
                            </h3>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:#ffeeba;">
                            <i class="fa fa-hourglass-half text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ongoing Orders -->
            <div class="col-xl-3 col-sm-6 mb-3">
                <div class="card same-card shadow-sm border-0" style="border-radius: 12px; background:#e8f5e9;">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ongoing Orders</h6>
                            <h3 class="mb-0 text-dark">
                                <%= stats.ongoingOrder %>
                            </h3>
                        </div>
                        <div class="rounded-circle d-flex align-items-center justify-content-center"
                             style="width:48px;height:48px;background:#c8e6c9;">
                            <i class="fa fa-truck text-success"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Completed Orders (Optional, derived) -->
            <div class="col-xl-3 col-sm-6 mb-3">
